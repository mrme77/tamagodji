# Optional runtime configuration. Keep secrets out of Git.
# Uncomment only if overriding the values in deploy/tamagodji.service.
# Blank assignments override systemd Environment= settings too.
# TAMAGODJI_DB=.data/pet.db
# TAMAGODJI_INTERACTION_PORT=/dev/serial/by-id/your-controller
# TAMAGODJI_ROOM_PORT=/dev/serial/by-id/your-light-sensor
TAMAGODJI_MICROPHONE_ENABLED=0
TAMAGODJI_API_ENABLED=1
TAMAGODJI_API_HOST=127.0.0.1
TAMAGODJI_API_PORT=8080
# REQUIRED for commands, even on localhost. Generate a random secret privately.
# Leave commented if a systemd override already provides this variable.
# TAMAGODJI_API_TOKEN=
TAMAGODJI_CORS_ORIGIN=https://pasqualesalomone.com

# Keep this file secret on the Pi. Never put the key in website JavaScript.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

